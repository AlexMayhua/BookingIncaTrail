# URL interna (para server-side calls - sin certificado SSL)
NEXT_PUBLIC_INTERNAL_API_URL=http://localhost:3000

# ============================================
# 2. DATABASE - MongoDB Atlas
# ============================================
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/bookingincatrail?retryWrites=true&w=majority

# ============================================
